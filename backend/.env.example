# Copy to backend/.env and replace secret placeholders locally.
# Keep backend/.env out of Git and do not paste credentials into prompts.
SOC_AI_INTERNAL_TOKEN=replace_with_a_random_internal_token

# AI provider (Groq is the default; Ollama endpoints must use loopback).
SOC_AI_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional threat-intelligence provider credentials.
VIRUSTOTAL_API_KEY=replace_with_your_virustotal_api_key
ABUSEIPDB_API_KEY=replace_with_your_abuseipdb_api_key

# Backend bind settings. scripts/run-backend.sh forces host to loopback.
SOC_AI_HOST=127.0.0.1
SOC_AI_PORT=5000
SOC_AI_ALLOW_NON_LOOPBACK=false

# Database and optional Wazuh JSONL importer input.
# SOC_AI_DB_PATH defaults to backend/soc_alerts.db; set to a separate *demo*.db for demos.
# SOC_AI_DB_PATH=/absolute/path/to/soc_alerts-demo.db
WAZUH_ALERTS_FILE=/path/to/authorized/wazuh-alerts.jsonl

# Operational limits and retention settings.
SOC_AI_MAX_REQUEST_BYTES=1048576
SOC_AI_RATE_LIMIT_PER_MINUTE=120
SOC_AI_CORRELATION_WINDOW_MINUTES=15
SOC_AI_THREAT_INTEL_CACHE_TTL=3600
SOC_AI_THREAT_INTEL_RATE_LIMIT_PER_MINUTE=60
SOC_AI_ALERT_RETENTION_DAYS=90
SOC_AI_REPORT_RETENTION_DAYS=180

# Optional comma-separated users bootstrapped as administrators.
SOC_AI_ADMIN_USERS=
