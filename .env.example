# Placeholder only. The backend reads backend/.env when launched from backend/.
# Never replace these with real credentials in a committed file.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
SOC_AI_INTERNAL_TOKEN=replace_with_a_random_internal_token

# Optional local provider. Defaults to Groq; Ollama supports loopback URLs only.
# SOC_AI_PROVIDER=groq
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# Optional backend bind configuration. Non-loopback needs separate review.
# SOC_AI_HOST=127.0.0.1
SOC_AI_PORT=5000
# SOC_AI_ALLOW_NON_LOOPBACK=false
# Lab injection is disabled by default. Configure only for a dedicated lab.
SOC_AI_INJECT_ENABLED=false
# SOC_AI_INJECT_PATH=/var/log/soc-ai-lab.log
# SOC_AI_INJECT_ALLOWED_DIR=/var/log

# Optional rate, request, correlation, and retention limits.
# SOC_AI_RATE_LIMIT_PER_MINUTE=120
# SOC_AI_MAX_REQUEST_BYTES=1048576
# SOC_AI_CORRELATION_WINDOW_MINUTES=15
# SOC_AI_ALERT_RETENTION_DAYS=90
# SOC_AI_REPORT_RETENTION_DAYS=180

# Optional threat-intel providers and cache controls.
# VIRUSTOTAL_API_KEY=replace_with_your_virustotal_api_key
# ABUSEIPDB_API_KEY=replace_with_your_abuseipdb_api_key
# SOC_AI_THREAT_INTEL_RATE_LIMIT_PER_MINUTE=60
# SOC_AI_THREAT_INTEL_CACHE_TTL=3600

# Optional data import and initial administrator accounts.
# WAZUH_ALERTS_FILE=/path/to/authorized/wazuh-alerts.jsonl
# SOC_AI_ADMIN_USERS=admin-username

# ATT&CK validation reads data/mitre_techniques.json when available.
